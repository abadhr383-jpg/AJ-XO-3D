{
  "name": "aj-xo-3d",
  "version": "1.0.0",
  "private": true,
  "description": "AJ XO 3D — 3D Tic-Tac-Toe built with HTML5, CSS3 and JavaScript",
  "scripts": {
    "start": "npx serve .",
    "test": "node test/logic.test.js",
